# ===== courser 敏感配置模板 =====
# 复制为 .env（.env 已被 .gitignore 忽略），或直接在 TUI「设置」里填写。

# ---- PKU 学号/密码（可选）----
# 不配置则依赖浏览器密码管理器自动填充（打开登录页等待一小会直接点登录）。
# 注意：在 opencli 自动化窗口中，少数环境密码管理器不会自动填充，
# 此时必须在这里（或 TUI 设置）配置，脚本会先填好再点登录。
# PKU_USERNAME=
# PKU_PASSWORD=

# ---- 邮件通知（推荐 Gmail 应用专用密码）----
# Gmail：设置中开启两步验证后，到 https://myaccount.google.com/apppasswords
# 生成 16 位「应用专用密码」，填入 SMTP_PASS。163/QQ 等邮箱则开启 SMTP 服务并填对应服务器。
MAIL_TO=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=